# ===== Python =====
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ===== 凭证 / 运行时状态（敏感，勿提交）=====
# 用户运行时数据目录（凭证/会话/本地配置），由 paths.data_dir() 写入
data/
users_config.json      # 用户名+姓名+工号+密码hash
session_info.json      # 含实时登录 cookie（JSESSIONID 等）
last_config.txt        # 上次打开的方法路径

# ===== 日志 / 生成数据 =====
logs/
*.xlsx                 # 导出的报告/称量记录（生成物）
谱图/                  # 谱图 PDF（样品数据，体积大）

# ===== 工具本地产物 =====
.codegraph/
.claude/settings.local.json

# ===== 调试 / 临时文件 =====
*.bak
file.txt
session.txt
